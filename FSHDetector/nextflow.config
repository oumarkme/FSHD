// --- Parameters ---
params {
    input                   = null
    outdir                  = '/lab_nas_home_user/Mark/ONT/FSHD'
    ref_hg38                = '/lab_nas_home_user/Mark/reference_genome/hg38/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set_modified.fasta'
    ref_t2t                 = '/lab_nas_home_user/Mark/reference_genome/t2t/GCF_009914755.1_T2T-CHM13v2.0_genomic.fna'
    query_d4z4              = "${projectDir}/query/d4z4.fa"
    query_haplotype_markers = "${projectDir}/query/haplotype_markers.fa"
    query_p13e11            = "${projectDir}/query/P13E11.fasta"
    container_tools         = "${projectDir}/environment.sif"
}

// --- Container ---
apptainer {
    enabled    = true
    autoMounts = true
    runOptions = '-B /raid:/raid -B /lab_nas_home_user:/lab_nas_home_user -B /gene_lv:/gene_lv'
}

// --- Execution ---
workDir = '/raid/nf/tmp'

executor {
    cpus   = 67
    memory = '1200 GB'
}

process {
    container = params.container_tools
    cpus      = 20
    memory    = '64 GB'

    withName: 'ALIGN_T2T'      { cpus = 16; memory = '64 GB' }
    withName: 'BLAST_ANNOTATE' { cpus = 16; memory = '32 GB' }
}
