// --- Manifest ---
manifest {
    name            = 'FSHDetector'
    description     = 'ONT D4Z4 Repeat Unit Counting, Haplotyping, and Methylation Pipeline'
    homePage        = 'https://github.com/oumarkme/FSHD'
    mainScript      = 'main.nf'
    author          = 'Mark'
    version         = '5.0'
    nextflowVersion = '>=23.04.0'
}

// --- Parameters ---
params {
    // Required (provide on the command line):
    input                   = null   // hg38-aligned BAM/CRAM with HP/PS + MM/ML tags
    ref_hg38                = null   // hg38 reference FASTA (input's alignment reference)
    ref_t2t                 = null   // T2T-CHM13v2.0 reference FASTA (+ .fai alongside)

    // Output (relative to the launch dir by default):
    outdir                  = 'results'

    // Bundled query sequences (resolved next to main.nf):
    query_d4z4              = "${projectDir}/query/d4z4.fa"
    query_haplotype_markers = "${projectDir}/query/haplotype_markers.fa"
    query_p13e11            = "${projectDir}/query/P13E11.fasta"
}

// --- Software environment ---
// Engine: Conda. Users need only Nextflow + Conda (Miniforge recommended);
// Nextflow builds the environment from environment.yml on the first run, so no
// manual installs or root access are required.
conda {
    enabled  = true
    useMamba = true
}

// --- Execution ---
// workDir and the executor budget default to the local host (Nextflow
// auto-detects the available CPUs/memory).

process {
    // All tools come from the Conda environment built from environment.yml.
    conda = "${projectDir}/environment.yml"

    // Robust bash: abort on errors, unset vars, and broken pipes so a
    // truncated samtools/minimap2 stream can never silently yield a partial BAM.
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Lenient caching keeps -resume reliable on shared/NFS storage.
    cache = 'lenient'

    // Retry once on transient / OOM-style failures, then stop.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'terminate' }
    maxRetries    = 1

    // Modest defaults so the pipeline schedules on a typical 16-32 GB
    // workstation, not just a large server. The floor (~16 GB) is set by
    // minimap2 loading the T2T genome (~12 GB measured); everything else is
    // lighter. cpus/memory are not part of the task hash, so a big server can
    // safely raise them in a profile without invalidating -resume caches.
    cpus   = 4
    memory = '8 GB'

    withName: 'EXTRACT_FSHD_READS' { cpus = 8; memory = '12 GB' }  // CRAM decode + full-file unmapped scan (streaming)
    withName: 'ALIGN_T2T'          { cpus = 8; memory = '16 GB' }  // minimap2 loads the T2T genome (~12 GB) + sort
    withName: 'EXTRACT_D4Z4'       { cpus = 4; memory = '8 GB'  }  // small T2T subset
    withName: 'BLAST_ANNOTATE'     { cpus = 8; memory = '12 GB' }  // blastn (threaded) + python annotation
    withName: 'METHYLATION'        { cpus = 8; memory = '12 GB' }  // modkit pileup (threaded)
    withName: 'REPORT'             { cpus = 2; memory = '4 GB'  }  // single-threaded pandas
}

// --- Profiles ---
profiles {
    // Conda — the default engine. This profile just makes the choice explicit;
    // running with no profile behaves identically.
    conda {
        conda.enabled = true
    }

    // Fast wiring smoke-test (no engine, no real data). Placeholder inputs must
    // exist because the workflow checks them (checkIfExists), so create them
    // first:
    //   touch x.bam x.bam.bai x.fa x.fa.fai
    //   nextflow run main.nf -stub-run -profile test \
    //       --input x.bam --ref_hg38 x.fa --ref_t2t x.fa
    // Conda is disabled here so each process's stub block (touch) runs directly
    // on the host with no environment build. The generous virtual budget lets
    // the stub tasks schedule on any host.
    test {
        conda.enabled = false
        executor { cpus = 64; memory = '512 GB' }
    }
}
