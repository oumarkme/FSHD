Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    maintainer Mark
    description nf-fshd v4: D4Z4 repeat analysis pipeline

%post
    mamba install -y -n base \
        python=3.12 \
        bioconda::samtools=1.23 \
        bioconda::minimap2=2.30 \
        bioconda::blast=2.17.0 \
        bioconda::ont-modkit=0.6.1 \
        bioconda::pysam=0.23.3 \
        bioconda::flye=2.9.6 \
        bioconda::racon=1.5.0 \
        bioconda::seqkit=2.13.0 \
        conda-forge::pandas=3.0.1 \
        conda-forge::jenkspy=0.4.1 \
    && mamba clean -afy
